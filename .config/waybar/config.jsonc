{
    "layer": "top",
    "position": "top",
    "height": 35,
    "spacing": 4,

    "modules-left": [
        "custom/void",
        "custom/tabs"
    ],
    "modules-center": [
        "ext/workspaces"
    ],
    "modules-right": [
        "cpu",
        "pulseaudio",
        "tray",
        "bluetooth",
        "battery",
        "clock"
    ],

    "custom/void": {
        "format": "",
        "tooltip": false,
        "on-click": "fuzzel"
    },

    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-id": true
    },

    "custom/tabs": {
        "exec": "/home/krish/.config/waybar/scripts/workspace_tabs.py",
        "return-type": "json",
        "format": "{}",
        "on-click": "/home/krish/.config/waybar/scripts/focus_window.py next",
        "on-click-right": "/home/krish/.config/waybar/scripts/focus_window.py prev",
        "on-click-middle": "/home/krish/.config/waybar/scripts/focus_window.py close"
    },

    "cpu": {
        "interval": 2,
        "format": "  {icon0}{icon1}{icon2}{icon3}{icon4}{icon5}  {usage}%",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "tooltip": true,
        "on-click": "/home/krish/.config/waybar/scripts/toggle_btop.sh"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  Muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋋",
            "headset": "󰋋",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 1020,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "alacritty -e alsamixer",
        "tooltip-format": "{desc} | Volume: {volume}%"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱  {device_alias}",
        "format-connected-battery": "󰂱  {device_alias}  {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "  {device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "  {device_alias}\t{device_address}  ({device_battery_percentage}%)",
        "on-click": "/home/krish/.config/waybar/scripts/toggle_bluetooth.sh",
        "on-click-right": "rfkill toggle bluetooth"
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰂄  {capacity}%",
        "format-alt": "{icon}  {time}",
        "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\nPower draw: {power}W"
    },

    "clock": {
        "interval": 1,
        "format": "  {:%I:%M %p   󰃭  %a, %b %d}",
        "tooltip-format": "Click to toggle calendar popup",
        "on-click": "gsimplecal"
    }
}
